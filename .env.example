# Copy to .env and fill in. Never commit .env.
# Nested groups use a double underscore: GROUP__SETTING=value
# Full list with defaults: docs/CONFIGURATION.md  (or run: fall-detector check-config)

# ---- Wearable input (MQTT)
MQTT__ENABLED=true
MQTT__USERNAME=
MQTT__PASSWORD=
# MQTT__HOST=io.adafruit.com
# MQTT__TOPIC=tranhao/feeds/fall_alert

# ---- Telegram alerts
TELEGRAM__ENABLED=true
TELEGRAM__BOT_TOKEN=
TELEGRAM__CHAT_ID=

# ---- Asterisk phone call + SIP message
AMI__ENABLED=true
AMI__USERNAME=
AMI__SECRET=
# AMI__HOST=127.0.0.1
# AMI__EXTENSIONS=["6001","6002","6004"]

# ---- Camera
# ESP32-CAM MJPEG stream, tried before the webcams, e.g. http://esp32cam.local:81/stream
CAMERA__STREAM_URL=
# CAMERA__WEBCAM_INDICES=[2,0,1]
# CAMERA__SHOW_WINDOW=false        # headless server / Docker

# ---- Alerts
# ALERTS__COOLDOWN_S=60

# ---- Operations
# LOGGING__LEVEL=INFO
# LOGGING__FORMAT=text             # json for log collectors
# HEALTH__PORT=8080
# DATABASE__PATH=fall_events.db
